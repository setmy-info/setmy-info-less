{
    "name": "setmy-info-less-modules",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "bootstrap": "npm ci",
        "clean": "node ./tools/run-workspaces.js clean && node ./tools/clean-root.js",
        "validate": "node ./tools/run-workspaces.js validate",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "node ./tools/run-workspaces.js lint",
        "resources": "node ./tools/run-workspaces.js resources",
        "build": "node ./tools/run-workspaces.js build",
        "test": "node --test tools/test/unit/*.test.js && node ./tools/run-workspaces.js test",
        "pre-integration-test": "node ./tools/run-workspaces.js pre-integration-test",
        "integration-test": "node ./tools/run-workspaces.js integration-test",
        "post-integration-test": "node ./tools/run-workspaces.js post-integration-test",
        "pre-e2e-test": "node ./tools/run-workspaces.js pre-e2e-test",
        "e2e-test": "node ./tools/run-workspaces.js e2e-test",
        "post-e2e-test": "node ./tools/run-workspaces.js post-e2e-test",
        "coverage": "node ./tools/run-workspaces.js coverage",
        "security": "npm audit --audit-level=high",
        "verify": "node ./tools/run-workspaces.js verify",
        "package": "node ./tools/run-workspaces.js package",
        "sbom": "node ./tools/run-workspaces.js sbom",
        "sign": "node ./tools/run-workspaces.js sign",
        "install-local": "node ./tools/run-workspaces.js install-local",
        "publish": "node ./tools/run-workspaces.js publish",
        "deploy": "node ./tools/run-workspaces.js deploy",
        "docs": "node ./tools/run-workspaces.js docs",
        "site": "node ./tools/run-workspaces.js site && node ./tools/aggregate-site.js",
        "server": "node ./tools/http-server.js",
        "stop-server": "node ./tools/http-server.js stop"
    },
    "version": "5.0.0",
    "description": "SMI LESS/CSS framework monorepo - layered LESS modules",
    "license": "MIT",
    "author": "Imre Tabur <imre.tabur@mail.ee>",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "devDependencies": {
        "express": "^5.2.1",
        "jest": "^30.4.2",
        "kss": "^3.1.0",
        "less": "^4.9.0",
        "less-plugin-clean-css": "^1.6.0",
        "less-watch-compiler": "^1.19.9",
        "postcss-less": "^6.0.0",
        "prettier": "^3.9.5",
        "pug": "^3.0.4",
        "rimraf": "^6.1.3",
        "selenium-webdriver": "^4.47.0",
        "stylelint": "^17.14.1",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-less": "^4.2.1"
    },
    "overrides": {
        "linkify-it": "^6.1.0",
        "locutus": "^3.0.36",
        "minimatch": "^10.2.6",
        "markdown-it": "^15.0.0"
    }
}
