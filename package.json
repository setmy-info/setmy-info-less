{
    "name": "setmy-info-less-modules",
    "version": "5.1.1",
    "description": "SMI LESS/CSS framework monorepo - layered LESS modules",
    "license": "MIT",
    "author": "Imre Tabur <imre.tabur@mail.ee>",
    "type": "module",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "clean": "node scripts/clean.js",
        "format": "node scripts/format.js",
        "format:check": "node scripts/format.js --check",
        "lint": "stylelint \"packages/*/src/main/less/**/*.less\"",
        "build": "npm run build --workspaces --if-present",
        "resources": "node scripts/resources.js",
        "verify": "node scripts/verify.js",
        "pre-integration-test": "node scripts/lifecycle.js pre-integration-test",
        "post-integration-test": "node scripts/lifecycle.js post-integration-test",
        "pre-e2e-test": "node scripts/lifecycle.js pre-e2e-test",
        "post-e2e-test": "node scripts/lifecycle.js post-e2e-test",
        "test": "node scripts/test.js unit",
        "integration-test": "node scripts/test.js integration",
        "e2e-test": "node scripts/test.js e2e",
        "coverage": "node scripts/test.js coverage",
        "audit": "npm audit --audit-level=high",
        "reports": "node scripts/reports.js",
        "docs": "node scripts/docs.js",
        "package": "node scripts/package.js",
        "deploy": "node scripts/deploy.js",
        "release": "node scripts/release.js",
        "server": "node scripts/http-server.js",
        "stop-server": "node scripts/http-server.js stop"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "devDependencies": {
        "express": "^5.2.1",
        "jest": "^30.4.2",
        "jest-junit": "^17.0.0",
        "kss": "^3.1.0",
        "less": "^4.9.0",
        "less-plugin-clean-css": "^1.6.0",
        "less-watch-compiler": "^1.19.9",
        "postcss-less": "^6.0.0",
        "prettier": "^3.9.5",
        "pug": "^3.0.4",
        "selenium-webdriver": "^4.47.0",
        "stylelint": "^17.14.1",
        "stylelint-config-standard": "^40.0.0"
    },
    "overrides": {
        "linkify-it": "^6.1.0",
        "locutus": "^3.0.36",
        "minimatch": "^10.2.6",
        "markdown-it": "^15.0.0"
    }
}
