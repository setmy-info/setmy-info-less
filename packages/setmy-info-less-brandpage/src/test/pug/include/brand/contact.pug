//- brand/contact — .cw contact rows and the social chip row. Used by the index page.
mixin brandContact()
    div(id="cw", class="cw")
        div(id="contactRow", class="cr")
            div(class="cl") Lorem
            div(class="cv") Ipsum dolor sit amet
        div(class="cr")
            div(class="cl") Ipsum
            div(class="cv")
                a(href="#") dolor@example.com
        div(id="so", class="so")
            a(id="socialChip", href="#", class="sa") Lorem
            a(href="#", class="sa") Ipsum
            a(href="#", class="sa") Dolor
