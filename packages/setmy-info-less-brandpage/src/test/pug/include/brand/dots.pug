//- brand/dots — #dots panel rail. Used by the pages that stack more than one panel.
mixin brandDots()
    div(id="dots")
        button(id="dot1", type="button", class="dot on", aria-label="Panel 1")
        button(id="dot2", type="button", class="dot", aria-label="Panel 2")
        button(id="dot3", type="button", class="dot", aria-label="Panel 3")
