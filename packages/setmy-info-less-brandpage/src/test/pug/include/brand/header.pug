//- brand/header — #hdr brand bar. Used by every brand page.
mixin brandHeader()
    header(id="hdr")
        span(id="bm", class="bm")
            | Lorem
            b Ipsum
        div(class="lsw floatRight")
            button(id="languageEn", type="button", class="lb on") EN
            button(id="languageEt", type="button", class="lb") ET
