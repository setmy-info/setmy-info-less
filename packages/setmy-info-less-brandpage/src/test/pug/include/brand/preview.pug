//- brand/preview — #prv privacy overlay. Hidden until .open is set.
mixin brandPreview()
    div(id="prv")
        div(class="pvh")
            span(class="pvt") Lorem ipsum
            button(id="previewClose", type="button", class="pvx floatRight") Close
        div(class="pvb")
            div(class="pvc")
                div(id="previewSection", class="pvs")
                    p
                        strong Lorem ipsum
                    p Dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore.
                div(class="pvs")
                    p
                        strong Ipsum dolor
                    p Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip.
                p(class="pvn") Lorem ipsum, 2026
