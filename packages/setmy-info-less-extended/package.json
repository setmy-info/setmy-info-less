{
    "name": "setmy-info-less-extended",
    "version": "5.1.0",
    "description": "SMI LESS project",
    "main": "dist/main.min.css",
    "dependencies": {
        "setmy-info-less": "*"
    },
    "scripts": {
        "format": "prettier --write .",
        "lint": "stylelint \"src/main/less/**/*.less\"",
        "lint:fix": "stylelint \"src/main/less/**/*.less\" --fix",
        "build": "node ../../scripts/build.js",
        "server": "node ../../scripts/http-server.js",
        "stop-server": "node ../../scripts/http-server.js stop",
        "watch": "less-watch-compiler ./src/main/less dist main.less",
        "watch:pug": "node ../../scripts/pugWatch.cjs"
    },
    "keywords": [
        "less",
        "css",
        "pug",
        "selenium",
        "jest"
    ],
    "author": "Imre Tabur <imre.tabur@mail.ee>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/setmy-info/setmy-info-less.git"
    },
    "homepage": "https://github.com/setmy-info/setmy-info-less",
    "style": "dist/main.css",
    "files": [
        "dist/main.css",
        "dist/main.min.css",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=24.0.0"
    },
    "config": {
        "server": {
            "port": 43631,
            "directory": "dist"
        },
        "cssExpectation": "content"
    }
}
