{
    "name": "setmy-info-less-ide",
    "version": "5.0.0",
    "description": "SMI LESS IDE \u2014 developer tool and IDE-style UI patterns, builds on the enterprise package",
    "main": "dist/main.min.css",
    "dependencies": {
        "setmy-info-less-enterprise": "*"
    },
    "scripts": {
        "clean": "node ../../tools/clean.js",
        "validate": "node ../../tools/validate.js",
        "format": "prettier --write .",
        "lint": "stylelint src/main/less/**/*.less",
        "lint:fix": "stylelint src/main/less/**/*.less --fix",
        "resources": "node ../../tools/resources.js",
        "build": "node ../../tools/build.js",
        "server": "node ../../tools/http-server.js",
        "stop-server": "node ../../tools/http-server.js stop",
        "watch": "less-watch-compiler ./src/main/less dist main.less",
        "watch:pug": "node ../../tools/pugWatch.cjs",
        "test": "node ../../tools/run-tests.js unit",
        "pre-integration-test": "node ../../tools/preintegration-test.js",
        "integration-test": "node ../../tools/integration-test.js",
        "post-integration-test": "node ../../tools/postintegration-test.js",
        "pre-e2e-test": "node ../../tools/pree2e-test.js",
        "e2e-test": "node ../../tools/e2e-test.js",
        "post-e2e-test": "node ../../tools/poste2e-test.js",
        "coverage": "node ../../tools/coverage.js",
        "verify": "node ../../tools/verify.js",
        "package": "node ../../tools/package.js",
        "sbom": "node ../../tools/package.js --sbom",
        "sign": "node ../../tools/sign.js",
        "install-local": "node ../../tools/install-local.js",
        "publish": "node ../../tools/publish.js",
        "deploy": "node ../../tools/deploy.js",
        "docs": "node ../../tools/docs.js",
        "site": "node ../../tools/site.js"
    },
    "keywords": [
        "less",
        "css",
        "ide",
        "developer",
        "tools"
    ],
    "author": "Imre Tabur <imre.tabur@mail.ee>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/setmy-info/setmy-info-less.git"
    },
    "homepage": "https://github.com/setmy-info/setmy-info-less",
    "style": "dist/main.css",
    "files": [
        "dist/main.css",
        "dist/main.min.css",
        "README.md",
        "LICENSE",
        "dist/experimental.css"
    ],
    "engines": {
        "node": ">=24.0.0"
    },
    "config": {
        "server": {
            "port": 43931,
            "directory": "dist"
        },
        "cssExpectation": "content",
        "less": {
            "additionalEntries": [
                {
                    "input": "src/main/less/experimental/main.less",
                    "output": "experimental.css",
                    "minify": false
                }
            ]
        }
    }
}
